{
  "name": "docker-visualizer",
  "version": "0.1.0",
  "description": "Remotion 视频解析：Docker 底层技术（cgroup / namespace / chroot / overlayfs）",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-remotion.js",
    "dev": "remotion studio --ipv4",
    "build:cpu": "remotion render CpuThrottle out/cpu-throttle.mp4",
    "build:epoll": "remotion render GenericTopic out/generic-epoll.mp4",
    "build:both": "npm run build:cpu && npm run build:epoll"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.448",
    "@remotion/cli": "4.0.448",
    "@remotion/renderer": "4.0.448",
    "@remotion/studio": "4.0.448",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.448"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.6.3"
  }
}